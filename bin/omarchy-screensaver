#!/bin/bash

# omarchy:summary=Run the Omarchy screensaver using random effects from TTE.

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  # Stop the effect loop first, so it can't start another effect in its place.
  kill "$effects" "$focus_watch" "$events_pid" 2>/dev/null
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
  pkill -x ttfx 2>/dev/null
  pkill -f '[o]rg.omarchy.screensaver' 2>/dev/null
  exit 0
}

# Exit the screensaver on signals and input from keyboard and mouse
trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'  # Set background color to black

hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null

# Terminals allocate the pty at the default 80x24 and only resize it once the
# compositor has told the window how big it is. ttfx measures the terminal once,
# at startup, so starting it before the resize lands sizes an 80x24 canvas and
# paints it into the corner of a fullscreen window.
wait_for_terminal_resize() {
  local deadline=$((SECONDS + 2))
  while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
    sleep 0.02
  done
}

# Open Hyprland's event stream before anything can move focus, so no change is missed.
exec {events}< <(socat -U - "UNIX-CONNECT:$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock")
events_pid=$!

wait_for_terminal_resize

# One random effect after another until the screensaver ends. An effect ended
# by a signal ends the loop: omarchy-system-lock stops ttfx, waits for it, then
# closes the window, and a replacement would race that. A failed effect is
# retried after a pause rather than in a tight loop.
(
  while true; do
    ttfx -i ~/.config/omarchy/branding/screensaver.txt \
      --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c \
      --random-effect --no-eol --no-restore-cursor
    status=$?
    if (( status > 128 )); then
      break
    elif (( status != 0 )); then
      sleep 1
    fi
  done
) &
effects=$!

# Leave once another window has focus. Focus passes through other monitors'
# windows while the launcher opens one screensaver per monitor, so each change
# away is confirmed a second later rather than acted on at once.
(
  sleep 1
  screensaver_in_focus || kill -TERM $$
  while IFS= read -r -u "$events" line; do
    [[ $line == activewindow\>\>* && $line != activewindow\>\>org.omarchy.screensaver,* ]] || continue
    sleep 1
    screensaver_in_focus || kill -TERM $$
  done
  # Without the event stream focus can't be followed, so leave rather than
  # stay up unwatched, as a failed focus check always has.
  kill -TERM $$
) &
focus_watch=$!

# Any key ends it.
read -n1
exit_screensaver
